# System unit for a Linux server without Docker. Adjust User, paths, and the token file.
[Unit]
Description=serp-drift app and scheduler
After=network-online.target
Wants=network-online.target

[Service]
User=serp
Group=serp
WorkingDirectory=/srv/serp-drift
Environment=SERP_DRIFT_DIR=/srv/serp-drift
EnvironmentFile=-/etc/serp-drift.env
ExecStart=/usr/bin/python3 -m serp_drift serve --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/serp-drift

[Install]
WantedBy=multi-user.target
